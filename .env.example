###############################################################################
# Aadex HMS — Backend API (Laravel 12)
#
# Copy to .env and fill in.  This is an API-only backend: there is no frontend
# build here, so nothing below drives Vite/Node.
#     cp .env.example .env && php artisan key:generate
###############################################################################

APP_NAME="Aadex HMS"
APP_ENV=local
APP_KEY=
# Set BOTH of these for anything reachable by someone else: APP_ENV=production
# and APP_DEBUG=false. With debug on, every error response carries a stack
# trace and absolute filesystem paths, and Laravel's debug page renders
# environment values — including the DB password.
APP_DEBUG=true
# Match how you actually reach the app — Swagger's "Try it out" base URL is
# built from this. Apache/XAMPP subdirectory: http://localhost/Aadex-Backend
# `php artisan serve`:              http://localhost:8000
APP_URL=http://localhost/Aadex-Backend

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

###############################################################################
# Database — MySQL (create the schema first: CREATE DATABASE aadex_backend;)
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aadex_backend
DB_USERNAME=root
DB_PASSWORD=

###############################################################################
# Cache / session / queue
#
# These default to the `database` driver because Redis is not provisioned yet.
# Switch all three to `redis` once a Redis server is available — see
# docs/implementation-plan.md §2 for the target configuration.
###############################################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# predis (pure PHP) rather than phpredis, since XAMPP's php.exe ships without
# the phpredis extension. Only used once the drivers above are switched over.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Mail — password-reset OTPs are delivered through this mailer.
#
# With MAIL_MAILER=log the OTP is written to storage/logs/laravel.log instead
# of being emailed, which is what you want in local dev. Point it at real SMTP
# before anyone outside the team uses forgot-password.
###############################################################################

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@aadex.test"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Broadcasting — Laravel Reverb (used by the Restaurant/KOT module, Phase 4)
#
# Generate a fresh id/key/secret per environment with:
#     php artisan reverb:install
###############################################################################

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

###############################################################################
# API documentation (l5-swagger)
#
# Swagger UI: {APP_URL}/api/documentation   ·   raw spec: {APP_URL}/docs
# GENERATE_ALWAYS regenerates the spec on every request — handy locally,
# turn it off in production.
#
# The spec's `servers` entry (what "Try it out" posts to) defaults to
# {APP_URL}/api/v1. Only set L5_SWAGGER_CONST_HOST to override that — e.g. to
# document a staging host from a local checkout.
###############################################################################

L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true

###############################################################################
# API tokens (Sanctum)
#
# Minutes until an issued token expires. 10080 = 7 days. Expired rows are
# pruned daily by the scheduler (see routes/console.php).
###############################################################################

SANCTUM_TOKEN_EXPIRATION=10080

###############################################################################
# Object storage (optional — media library falls back to the local disk)
###############################################################################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
